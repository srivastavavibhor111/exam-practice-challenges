# Same Google OAuth Client ID as the backend — this one IS meant to be
# public (it identifies your app to Google, doesn't grant any access on
# its own). Must be the exact same value as backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# reCAPTCHA SITE key (not the secret) — also meant to be public, this is
# what actually renders the widget in the browser.
VITE_RECAPTCHA_SITE_KEY=