# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Client ───────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── MongoDB Atlas (free tier) ────────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

# ─── AI (added in M9 — Extraction Engine) ────────────────────────────────────
# Google Gemini API key — FREE tier, no credit card required.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

#----------- gemini patch env additions --------------------------------------
# Encrypts/decrypts stored Gemini API keys (AES-256-GCM). Must be a
# 64-character hex string (32 raw bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Losing or rotating this key makes every already-stored API key
# permanently undecryptable — back it up somewhere safe, the same way
# you'd treat JWT_SECRET.
ENCRYPTION_KEY=


# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/exam-practice-challenges

# Secret used to sign session JWTs. Must be long, random, and NEVER
# committed or shared. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
JWT_SECRET=paste-a-long-random-string-here

# The frontend's origin — required now that CORS uses credentials:true,
# which does not work with a wildcard origin. Matches Vite's default dev
# port from M1's vite.config.js.
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Client ID — verifies Google ID tokens server-side.
# Get this from Google Cloud Console — see google-cloud-console-setup.txt.
GOOGLE_CLIENT_ID=

# reCAPTCHA secret key — verifies reCAPTCHA tokens server-side. Never
# expose this to the frontend; it's different from the site key below.
# Get this from the reCAPTCHA admin console — see recaptcha-setup.txt.
RECAPTCHA_SECRET_KEY=